# Copy this file to .env to change defaults.
# Backend API + WebSocket port
PORT=3001

# Optional: logging level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# ----- Executer engine (Binance USDⓈ-M futures) -----
# Paper trading is the default. Live trading stays OFF unless explicitly enabled.
ENABLE_LIVE_TRADING=false
# ENABLE_AUTO_TRADE gates LIVE auto-trade only (still off by default).
ENABLE_AUTO_TRADE=false
# Autopilot: automatically open PAPER positions on scan (never live).
ENABLE_AUTO_PAPER=true

# ----- Autopilot cadence (paper only) -----
# Runs aligned to candle close. Scan/entry timeframe + max new positions per run.
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MINUTES=5
AUTOPILOT_SIGNAL_INTERVAL=5m
AUTOPILOT_MAX_TRADES=3
# Max symbols the screener will analyze per scan (movers whose klines are
# unavailable are skipped automatically).
SCREENER_MAX_ANALYZE=40

# Market mode: futures only
MAX_LEVERAGE=10

# Equity engine: deploy 25% (½ of ½), keep 75% reserve
ACCOUNT_BALANCE_USD=50
EQUITY_DEPLOY_FRACTION=0.25
EQUITY_MAX_CONCURRENT=2
EQUITY_DRAWDOWN_THROTTLE=0.25
EQUITY_DRAWDOWN_STOP=0.5

# Binance keys. Use testnet keys while testing (futures testnet when BINANCE_TESTNET=true).
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Risk limits
MAX_ORDER_NOTIONAL_USD=1000
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE_USD=5000
MAX_DAILY_LOSS_USD=200

# Account capital (0 = disabled). Max total exposure = min(MAX_TOTAL_EXPOSURE_USD, capital × MAX_LEVERAGE).
ACCOUNT_CAPITAL_USD=0
# Paper round-trip fee % applied to realized PnL (0.1 = 0.1%)
PAPER_FEE_PCT=0

# Defaults used by the auto-trade agent action
EXECUTER_EQUITY=10000
EXECUTER_RISK_PCT=1
