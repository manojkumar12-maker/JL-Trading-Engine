# Copy this file to .env to change defaults.
# Backend API + WebSocket port
PORT=3001

# Optional: logging level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# ----- Executer engine -----
# Paper trading is the default. Live trading stays OFF unless explicitly enabled.
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_TRADE=false

# Binance (spot). Use testnet keys while testing.
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Risk limits
MAX_ORDER_NOTIONAL_USD=1000
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE_USD=5000
MAX_DAILY_LOSS_USD=200

# Defaults used by the auto-trade agent action
EXECUTER_EQUITY=10000
EXECUTER_RISK_PCT=1
