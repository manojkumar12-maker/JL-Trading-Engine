# Copy this file to .env to change defaults.
# Backend API + WebSocket port
PORT=3001

# Optional: logging level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# ----- Executer engine (Binance USDⓈ-M futures) -----
# Paper trading is the default. Live trading stays OFF unless explicitly enabled.
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_TRADE=false

# Market mode: futures only
MAX_LEVERAGE=10

# Binance keys. Use testnet keys while testing (futures testnet when BINANCE_TESTNET=true).
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Risk limits
MAX_ORDER_NOTIONAL_USD=1000
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE_USD=5000
MAX_DAILY_LOSS_USD=200

# Account capital (0 = disabled). Max total exposure = min(MAX_TOTAL_EXPOSURE_USD, capital × MAX_LEVERAGE).
ACCOUNT_CAPITAL_USD=0
# Paper round-trip fee % applied to realized PnL (0.1 = 0.1%)
PAPER_FEE_PCT=0

# Defaults used by the auto-trade agent action
EXECUTER_EQUITY=10000
EXECUTER_RISK_PCT=1
